{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "customManagers": [
    {
      "customType": "regex",
      "datasourceTemplate": "go",
      "depNameTemplate": "github.com/Luzifer/gziphttp",
      "description": "Update gziphttp in the Dockerfile",
      "managerFilePatterns": [
        "/^Dockerfile$/"
      ],
      "matchStrings": [
        "go install github\\.com/Luzifer/gziphttp@(?<currentValue>v?[0-9]+\\.[0-9]+\\.[0-9]+)"
      ]
    }
  ],
  "extends": [
    "local>luzifer/renovate-config"
  ]
}